# 이 파일을 복사해 backend/.env를 만들고 개인 환경에 맞게 값을 채웁니다.
# 실제 .env 파일은 Git에 올리지 않습니다.
DB_URL=jdbc:mysql://localhost:3306/tripai?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME
SERVER_PORT=8080
JWT_SECRET=CHANGE_ME

# 공공데이터포털 TourAPI에서 발급받은 "Decoding" 서비스 키를 입력합니다.
# 실제 backend/.env 파일만 수정하고, 키는 GitHub·채팅에 올리지 않습니다.
TOUR_API_SERVICE_KEY=CHANGE_ME
# 선택값: 기본 주소와 앱 이름을 바꿀 일이 있을 때만 사용합니다.
# TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
# TOUR_API_MOBILE_APP=TripAI
