# 이 파일을 복사해 backend/.env를 만들고 개인 환경에 맞게 값을 채웁니다.
# 실제 .env 파일은 Git에 올리지 않습니다.
DB_URL=jdbc:mysql://localhost:3306/tripai?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME
SERVER_PORT=8080
JWT_SECRET=CHANGE_ME

# 서울시 문화행사 정보 API 수집·분류값 확인
SEOUL_CULTURE_API_KEY=CHANGE_ME

BATCH_EVENT_INITIAL_LOAD=false