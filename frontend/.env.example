# 이 파일을 참고해 .env를 새로 생성해서 작업하세요.
# .env.development 등 .env.* 파일도 기존 .gitignore 규칙으로 제외됩니다.
# 백엔드 주소는 공개 설정값이며, 백엔드에서 프론트엔드 origin의 CORS 요청을 허용해야 합니다.
# VITE_ 변수는 브라우저 코드에 노출되므로 비밀 키를 넣지 마세요.

VITE_API_BASE_URL=http://localhost:8080
VITE_USE_MOCK_API=true

# 나의 일정 API만 따로 목업으로 돌릴 때 사용 (없으면 VITE_USE_MOCK_API를 따름)
# 백엔드(API-PLAN-001~009, API-PLACE-001)가 준비되어 기본값은 false입니다.
# 실제 API를 쓰려면 DB에 database/schema/02·03 마이그레이션과 음식점 시드가 적용되어 있어야 합니다.
VITE_USE_PLAN_MOCK_API=false
# 홈의 월별 카드 목록은 행사 조회 API를 사용합니다. 백엔드 없이 화면을 확인할 때만 true로 바꾸세요.
VITE_USE_EVENT_MOCK_API=false
